# ===== ChrisVA Configuration =====

# --- Outlook (Microsoft Graph API) ---
# Register an app at https://portal.azure.com > App registrations
# Grant: Mail.Read, Calendars.Read (delegated or application)
OUTLOOK_CLIENT_ID=your-azure-app-client-id
OUTLOOK_TENANT_ID=your-azure-tenant-id
OUTLOOK_CLIENT_SECRET=your-azure-app-client-secret
OUTLOOK_USER_EMAIL=chris@your-org.com

# --- Jira ---
JIRA_HOST=https://your-org.atlassian.net
JIRA_EMAIL=chris@your-org.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ

# --- Slack ---
# Create a Slack app at https://api.slack.com/apps
# Bot scopes: chat:write, conversations:list, conversations:open, users:read
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token
SLACK_DEFAULT_CHANNEL=general
SLACK_TRIAGE_CHANNEL=merchant-triage

# --- Team Members ---
# Format: Name:jiraAccountId:slackUserId (slackUserId optional)
TEAM_MEMBERS=Alice:abc123:U_ALICE,Bob:def456:U_BOB,Carol:ghi789:U_CAROL

# --- Work Schedule ---
WORK_START_HOUR=9
WORK_END_HOUR=17
TIMEZONE=Europe/Amsterdam

# --- VA Preferences ---
EMAIL_CHECK_INTERVAL_MINUTES=15
PRIORITY_KEYWORDS=urgent,critical,blocker,asap,p0,production
MERCHANT_KEYWORDS=merchant,store,shop,commerce,order,payment,checkout

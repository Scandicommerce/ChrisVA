# ===== ChrisVA Configuration =====

# --- Jira ---
JIRA_HOST=https://your-org.atlassian.net
JIRA_EMAIL=chris@your-org.com
JIRA_API_TOKEN=your-jira-api-token
JIRA_PROJECT_KEY=PROJ

# --- Gmail (OAuth2) ---
# Place your Google OAuth credentials.json in the project root
# The app will guide you through auth on first run
GMAIL_USER=chris@your-org.com

# --- Team Members (comma-separated name:jiraAccountId pairs) ---
TEAM_MEMBERS=Alice:abc123,Bob:def456,Carol:ghi789

# --- Work Schedule ---
WORK_START_HOUR=9
WORK_END_HOUR=17
TIMEZONE=Europe/Amsterdam

# --- VA Preferences ---
EMAIL_CHECK_INTERVAL_MINUTES=15
PRIORITY_KEYWORDS=urgent,critical,blocker,asap,p0,production
MERCHANT_KEYWORDS=merchant,store,shop,commerce,order,payment

{
  "name": "chrisva",
  "version": "0.2.0",
  "description": "ChrisVA — Personal virtual assistant for Outlook email/calendar, Jira management, Slack notifications, and workday planning",
  "main": "dist/index.js",
  "bin": {
    "chrisva": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js briefing",
    "setup": "node dist/cli.js setup",
    "demo": "node dist/cli.js demo",
    "briefing": "node dist/cli.js briefing",
    "emails": "node dist/cli.js emails",
    "calendar": "node dist/cli.js calendar",
    "triage": "node dist/cli.js triage",
    "schedule": "node dist/cli.js schedule",
    "status": "node dist/cli.js status",
    "dashboard": "node dist/server.js",
    "dashboard:demo": "node dist/server.js --demo",
    "dev": "ts-node src/cli.ts",
    "lint": "eslint src/ --ext .ts",
    "test": "jest --passWithNoTests"
  },
  "dependencies": {
    "commander": "^12.1.0",
    "chalk": "^4.1.2",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "node-fetch": "^2.7.0",
    "ora": "^5.4.1",
    "inquirer": "^8.2.6",
    "dayjs": "^1.11.11"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/express": "^4.17.21",
    "@types/inquirer": "^8.2.10",
    "@types/node-fetch": "^2.6.11",
    "typescript": "^5.5.0",
    "ts-node": "^10.9.2",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.4",
    "@types/jest": "^29.5.12",
    "eslint": "^8.57.0",
    "@typescript-eslint/eslint-plugin": "^7.13.0",
    "@typescript-eslint/parser": "^7.13.0"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
